# Supabase: Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Only needed to run migrations with scripts/apply_migrations.py.
# Supabase -> Connect -> Session pooler URI, with your database password filled in.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# OpenRouter: openrouter.ai -> Keys
OPENROUTER_API_KEY=sk-or-...
# openrouter/free routes to any currently available free model; or pin one, e.g. google/gemma-4-31b-it:free
OPENROUTER_MODEL=openrouter/free

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# LangSmith: smith.langchain.com -> Settings -> API Keys
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=rag-masterclass
